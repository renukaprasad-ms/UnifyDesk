BACKEND_HOST_PORT=8001
BACKEND_CONTAINER_PORT=8001
SERVER_PORT=8001
SNOWFLAKE_NODE_ID=1
FLYWAY_BASELINE_ON_MIGRATE=false
APP_NOTIFICATION_ASYNC=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5100
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password
APP_DATASOURCE_WRITE_URL=jdbc:postgresql://your-db-host:5432/postgres
APP_DATASOURCE_WRITE_USERNAME=postgres
APP_DATASOURCE_WRITE_PASSWORD=your-database-password
APP_DATASOURCE_WRITE_MAX_POOL_SIZE=5
APP_DATASOURCE_WRITE_MIN_IDLE=1
APP_DATASOURCE_READ_URL=jdbc:postgresql://your-db-host:5432/postgres
APP_DATASOURCE_READ_USERNAME=postgres
APP_DATASOURCE_READ_PASSWORD=your-database-password
APP_DATASOURCE_READ_MAX_POOL_SIZE=3
APP_DATASOURCE_READ_MIN_IDLE=0
REDIS_HOST=redis
REDIS_PORT=6002
REALTIME_REDIS_CHANNEL=messaging:realtime
REALTIME_HEARTBEAT_INTERVAL_MS=30000
KAFKA_BOOTSTRAP_SERVERS=kafka:9002
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9002
KAFKA_CLIENT_ID=messaging-api
APP_KAFKA_QUEUE_CRITICAL_TOPIC=messaging.critical
APP_KAFKA_QUEUE_CRITICAL_PARTITIONS=1
APP_KAFKA_QUEUE_CRITICAL_REPLICAS=1
APP_KAFKA_QUEUE_CRITICAL_CONCURRENCY=1
APP_KAFKA_QUEUE_HIGH_TOPIC=messaging.high
APP_KAFKA_QUEUE_HIGH_PARTITIONS=1
APP_KAFKA_QUEUE_HIGH_REPLICAS=1
APP_KAFKA_QUEUE_HIGH_CONCURRENCY=1
APP_KAFKA_QUEUE_MEDIUM_TOPIC=messaging.medium
APP_KAFKA_QUEUE_MEDIUM_PARTITIONS=1
APP_KAFKA_QUEUE_MEDIUM_REPLICAS=1
APP_KAFKA_QUEUE_MEDIUM_CONCURRENCY=1
APP_KAFKA_QUEUE_LOW_TOPIC=messaging.low
APP_KAFKA_QUEUE_LOW_PARTITIONS=1
APP_KAFKA_QUEUE_LOW_REPLICAS=1
APP_KAFKA_QUEUE_LOW_CONCURRENCY=1
SPRING_KAFKA_CONSUMER_GROUP_ID=messaging-notification-workers

# Base64-encoded 32-byte AES key used to encrypt provider credentials at rest.
# Example generation: openssl rand -base64 32
CHANNEL_CREDENTIAL_MASTER_KEY=replace-with-base64-32-byte-key

# Meta WhatsApp Embedded Signup
META_WHATSAPP_ENABLED=false
META_WHATSAPP_APP_ID=your-meta-app-id
META_WHATSAPP_APP_SECRET=your-meta-app-secret
META_WHATSAPP_CONFIGURATION_ID=your-facebook-login-for-business-config-id
META_WHATSAPP_GRAPH_API_VERSION=v26.0
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-secret
META_WHATSAPP_SIGNUP_SESSION_TTL=10m
META_WHATSAPP_REGISTER_PHONE_NUMBER=true

# Gmail OAuth (server-side web application)
GMAIL_OAUTH_ENABLED=false
GMAIL_OAUTH_CLIENT_ID=your-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_OAUTH_REDIRECT_URI=https://messaging.renukaprasad.in/api/v1/oauth/gmail/callback
GMAIL_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.modify
GMAIL_OAUTH_STATE_TTL=10m
GMAIL_OAUTH_TOKEN_REFRESH_SKEW=2m

# Gmail realtime / Google Cloud Pub/Sub
# Topic must belong to the same Google Cloud project as GMAIL_OAUTH_CLIENT_ID.
# Grant gmail-api-push@system.gserviceaccount.com Pub/Sub Publisher on the topic.
GMAIL_PUBSUB_TOPIC_NAME=projects/your-google-cloud-project-id/topics/messaging-gmail
# Generate with: openssl rand -hex 32
# Configure the Pub/Sub push endpoint as:
# https://messaging.renukaprasad.in/api/v1/webhooks/google/gmail?token=<same-value>
GMAIL_PUBSUB_PUSH_VERIFICATION_TOKEN=replace-with-a-long-random-secret
GMAIL_WATCH_RENEW_INTERVAL=1h
GMAIL_WATCH_RENEW_INITIAL_DELAY=1m
GMAIL_WATCH_RENEW_AFTER=24h
GMAIL_REALTIME_WORKER_CONCURRENCY=4
GMAIL_REALTIME_WORKER_POLL_INTERVAL_MS=500
GMAIL_REALTIME_STALE_AFTER=5m
GMAIL_REALTIME_MAX_ATTEMPTS=12
GMAIL_REALTIME_HISTORY_PAGE_SIZE=200
GMAIL_REALTIME_BATCH_SIZE=25
GMAIL_REALTIME_SAFETY_SYNC_INTERVAL=5m
GMAIL_REALTIME_SAFETY_SYNC_INITIAL_DELAY=2m
GMAIL_REALTIME_RECOVERY_DAYS=30
GMAIL_REALTIME_RECOVERY_MAX_MESSAGES=1000

GMAIL_INITIAL_SYNC_DAYS=30
GMAIL_INITIAL_SYNC_MAX_MESSAGES=200
GMAIL_SYNC_MAX_RANGE_DAYS=366
GMAIL_SYNC_MAX_MESSAGES=100000

# Generic custom mailbox (per-account credentials are encrypted in provider_credentials)
IMAP_SMTP_ENABLED=true
IMAP_SMTP_CONNECT_TIMEOUT=10s
IMAP_SMTP_READ_TIMEOUT=20s
IMAP_SMTP_WRITE_TIMEOUT=20s
IMAP_SMTP_INCREMENTAL_POLL_INTERVAL=1m
IMAP_SMTP_INCREMENTAL_INITIAL_DELAY=1m
IMAP_SMTP_INCREMENTAL_MAX_MESSAGES_PER_FOLDER=250
IMAP_SMTP_INCREMENTAL_MAX_ATTEMPTS=12
IMAP_SMTP_SYNC_MAX_MESSAGES=10000
IMAP_SMTP_SYNC_MAX_RANGE_DAYS=366
IMAP_SMTP_WORKER_CONCURRENCY=4
IMAP_SMTP_WORKER_POLL_INTERVAL_MS=500
IMAP_SMTP_STALE_JOB_AFTER=10m

# Microsoft 365 / Outlook OAuth + Microsoft Graph
# Register a Web app in Microsoft Entra ID and configure the redirect URI below.
MICROSOFT_OAUTH_ENABLED=false
# Use "common" for Microsoft personal + work/school accounts, or a tenant ID for single-tenant.
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-entra-application-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=your-microsoft-entra-client-secret
MICROSOFT_OAUTH_REDIRECT_URI=https://messaging.renukaprasad.in/api/v1/oauth/microsoft/callback
MICROSOFT_WEBHOOK_NOTIFICATION_URL=https://messaging.renukaprasad.in/api/v1/webhooks/microsoft
MICROSOFT_OAUTH_SCOPE=openid profile email offline_access User.Read Mail.ReadWrite Mail.Send
MICROSOFT_OAUTH_STATE_TTL=10m
MICROSOFT_OAUTH_TOKEN_REFRESH_SKEW=2m

# Microsoft Graph mailbox synchronization
# Live Microsoft delta cursor only looks back briefly; historical import is user-selected.
MICROSOFT_LIVE_INITIAL_LOOKBACK=5m
MICROSOFT_BACKFILL_MAX_MESSAGES=10000
MICROSOFT_BACKFILL_MAX_RANGE_DAYS=365
MICROSOFT_BACKFILL_WORKER_CONCURRENCY=4
MICROSOFT_BACKFILL_POLL_INTERVAL_MS=500
MICROSOFT_BACKFILL_MAX_ATTEMPTS=12
MICROSOFT_DELTA_PAGE_SIZE=50
MICROSOFT_WORKER_CONCURRENCY=8
MICROSOFT_WORKER_POLL_INTERVAL_MS=500
MICROSOFT_SAFETY_SYNC_INTERVAL=5m
MICROSOFT_SAFETY_SYNC_INITIAL_DELAY=2m

# Microsoft Graph webhook subscription lifecycle
MICROSOFT_SUBSCRIPTION_LIFETIME=PT167H
MICROSOFT_SUBSCRIPTION_RENEW_BEFORE=24h
MICROSOFT_SUBSCRIPTION_RENEW_INTERVAL=12h

# Microsoft Graph retry / throttling
MICROSOFT_API_RETRY_MAX_ATTEMPTS=4
MICROSOFT_API_RETRY_INITIAL_BACKOFF=1s
MICROSOFT_API_RETRY_MAX_BACKOFF=30s

FRONTEND_HOST_PORT=5100
FRONTEND_CONTAINER_PORT=80
VITE_API_BASE_URL=http://localhost:8001
MEDIA_STORAGE_DEFAULT_PROVIDER=SUPABASE
MEDIA_UPLOAD_URL_EXPIRY=10m
MEDIA_DOWNLOAD_URL_EXPIRY=5m
MEDIA_STORAGE_HTTP_CONNECT_TIMEOUT=3s
MEDIA_STORAGE_HTTP_READ_TIMEOUT=5s
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_MEDIA_BUCKET=private-media
MEDIA_IMAGE_MAX_SIZE=10MB
MEDIA_DOCUMENT_MAX_SIZE=25MB
MEDIA_VIDEO_MAX_SIZE=100MB
MEDIA_AUDIO_MAX_SIZE=25MB
MEDIA_OTHER_MAX_SIZE=10MB
MEDIA_PENDING_TTL=24h
MEDIA_PENDING_CLEANUP_INITIAL_DELAY=1m
MEDIA_PENDING_CLEANUP_INTERVAL=12h
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

REDIS_IMAGE=redis:8.10.1-alpine
REDIS_HOST_PORT=6001
REDIS_CONTAINER_PORT=6002

KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_HOST_PORT=9001
KAFKA_CONTAINER_PORT=9002
KAFKA_CONTROLLER_PORT=9003
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9003
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9002,CONTROLLER://0.0.0.0:9003
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9002
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_FROM=no-reply@example.com
OTP_EMAIL_SUBJECT=Your verification code

JWT_ISSUER=messaging
JWT_PRIVATE_KEY=base64-pkcs8-rsa-private-key
JWT_PUBLIC_KEY=base64-x509-rsa-public-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ACCESS_COOKIE_NAME=msid
JWT_REFRESH_COOKIE_NAME=msid_r
JWT_ACCESS_COOKIE_MAX_AGE=15m
JWT_REFRESH_COOKIE_MAX_AGE=7d
JWT_COOKIE_PATH=/
JWT_COOKIE_DOMAIN=
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Strict

OTP_TTL=5m
OTP_RESEND_COOLDOWN=1m
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL=10m
# Storage accounting reconciliation
STORAGE_RECONCILIATION_CRON=0 30 3 * * *
STORAGE_RECONCILIATION_ZONE=UTC
STORAGE_RECONCILIATION_BATCH_SIZE=100

# Realtime WebSocket
REALTIME_ALLOWED_ORIGINS=https://messaging.renukaprasad.in

# Gmail batched sync
GMAIL_SYNC_MAX_MESSAGES=100000
GMAIL_SYNC_BATCH_SIZE=25
GMAIL_SYNC_USER_QUOTA_UNITS_PER_MINUTE=6000
GMAIL_SYNC_MESSAGE_GET_QUOTA_UNITS=20
GMAIL_SYNC_QUOTA_UTILIZATION_PERCENT=80

# Distributed Gmail quota control. Background sync is paced below Google's
# configured quota while reserving headroom for interactive sends.
GMAIL_QUOTA_CONTROL_ENABLED=true
GMAIL_QUOTA_PROJECT_UNITS_PER_MINUTE=1200000
GMAIL_QUOTA_INTERACTIVE_RESERVE_PERCENT=20
GMAIL_QUOTA_USER_BURST_UNITS=600
GMAIL_QUOTA_PROJECT_BURST_UNITS=50000
GMAIL_QUOTA_BACKGROUND_USER_BURST_UNITS=500
GMAIL_QUOTA_BACKGROUND_PROJECT_BURST_UNITS=40000
GMAIL_QUOTA_BUCKET_TTL=2m
GMAIL_QUOTA_COOLDOWN_INITIAL=30s
GMAIL_QUOTA_COOLDOWN_MAX=5m
GMAIL_SYNC_BATCH_RETRY_MAX_ATTEMPTS=12
GMAIL_SYNC_BATCH_RETRY_INITIAL_BACKOFF=2s
GMAIL_SYNC_BATCH_RETRY_MAX_BACKOFF=64s
GMAIL_SYNC_BATCH_RECOVERY_INTERVAL=1m
GMAIL_SYNC_BATCH_STALE_AFTER=5m
GMAIL_SYNC_BATCH_RECOVERY_SIZE=100
GMAIL_WORKER_CONCURRENCY=12
GMAIL_WORKER_POLL_INTERVAL_MS=250
