a:["$","section","How to start a request",{"children":[["$","h2",null,{"children":"How to start a request"}],[["$","p","0",{"children":"Authenticated users can request account deletion through available account controls. Authorized workspace administrators can request company deletion. For data uploaded by a business customer, contact that business first when appropriate."}],["$","p","1",{"children":"Data-deletion requests can be sent to support@unifydesk.in. Verify inbox delivery and the authenticated deletion workflow before submitting this URL to Meta; a recipient must not need a UnifyDesk account merely to ask for deletion."}]],"$undefined"]}]
b:["$","section","User account deletion",{"children":[["$","h2",null,{"children":"User account deletion"}],[["$","p","0",{"children":"The user-deletion backend checks ownership and current password, revokes access, marks the user DELETION_PENDING and schedules background purge work. Users who own workspaces must transfer or delete those workspaces first."}]],"$undefined"]}]
c:["$","section","Company workspace deletion",{"children":[["$","h2",null,{"children":"Company workspace deletion"}],[["$","p","0",{"children":"The company-deletion backend disconnects channels, initiates cancellation of associated billing arrangements, marks a workspace DELETION_PENDING and schedules staged purge work. It can include related inbox, company access, contact and media records."}]],"$undefined"]}]
d:["$","section","Disconnecting a provider",{"children":[["$","h2",null,{"children":"Disconnecting a provider"}],[["$","p","0",{"children":"Provider-specific disconnect may revoke credentials or remove a channel connection, but it is not necessarily the same as deleting all content already synchronized into UnifyDesk. Google, Microsoft, Zoho and Meta can also retain information under their own policies."}]],"$undefined"]}]
e:["$","section","Contact deletion and suppression",{"children":[["$","h2",null,{"children":"Contact deletion and suppression"}],[["$","p","0",{"children":"Contacts can be removed while keyed suppression fingerprints may be retained for opt-out and complaint protection, preventing re-import from silently restoring eligibility."}]],"$undefined"]}]
f:["$","section","Completion, exceptions and verification",{"children":[["$","h2",null,{"children":"Completion, exceptions and verification"}],[["$","p","0",{"children":"Backend deletion uses a configurable default 30-day grace period and retrying purge jobs. No guaranteed universal completion date, backup expiry or full provider erasure is established."}],["$","p","1",{"children":"Before publication, test database records, linked media, attachments, logs, backups, exports, invoices, provider-side revocation, retries and the exact deployed retention settings. Define identity verification, acknowledgements and permitted legal exceptions."}]],"$undefined"]}]
