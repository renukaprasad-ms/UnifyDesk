a:["$","article",null,{"children":[["$","header",null,{"className":"routeHero seoHero","children":[["$","p",null,{"className":"kicker","children":[["$","$L7",null,{"href":"/guides","children":"Resources"}]," / ","Email campaign guide"]}],["$","h1",null,{"children":"Email broadcast vs email marketing: what is the difference?"}],["$","p",null,{"children":"An email broadcast is a single campaign sent to a chosen audience. Email marketing is the broader process of earning permission, building useful campaigns and measuring results over time. The distinction helps you choose the right workflow and sender."}],["$","p",null,{"className":"guideByline","children":"UnifyDesk guides · Published October 2026 · Educational content"}]]}],["$","div",null,{"className":"guideLayout","children":[["$","div",null,{"className":"guideArticle","children":[[["$","section","What is an email broadcast?",{"className":"guideArticleSection","children":[["$","h2",null,{"children":"What is an email broadcast?"}],[["$","p","A broadcast is one message, such as a product update, newsletter or event invitation, sent to a segment of subscribers. It usually has a single message, audience definition, send time and results report.",{"children":"A broadcast is one message, such as a product update, newsletter or event invitation, sent to a segment of subscribers. It usually has a single message, audience definition, send time and results report."}],["$","p","Email marketing includes broadcasts but can also cover subscriber management, segmentation, lifecycle journeys, experimentation and reporting. A one-time broadcast does not automatically make a complete automation program.",{"children":"Email marketing includes broadcasts but can also cover subscriber management, segmentation, lifecycle journeys, experimentation and reporting. A one-time broadcast does not automatically make a complete automation program."}]],"$undefined",false]}],["$","section","Choose the right audience before the message",{"classNa