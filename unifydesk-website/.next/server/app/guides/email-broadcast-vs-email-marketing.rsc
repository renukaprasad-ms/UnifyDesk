16:["$","section","What UnifyDesk is building",{"className":"guideArticleSection","children":[["$","h2",null,{"children":"What UnifyDesk is building"}],[["$","p","UnifyDesk is developing a managed email campaign workflow with domain readiness, audience and consent context, and separate usage billing. Amazon SES is the current managed sending direction. The connected inbox serves a different, conversation-focused purpose.",{"children":"UnifyDesk is developing a managed email campaign workflow with domain readiness, audience and consent context, and separate usage billing. Amazon SES is the current managed sending direction. The connected inbox serves a different, conversation-focused purpose."}],["$","p","Public access is coming soon. For now, use the product tour to explore the intended workflow with illustrative sample data rather than assuming live sending is available.",{"children":"Public access is coming soon. For now, use the product tour to explore the intended workflow with illustrative sample data rather than assuming live sending is available."}]],"$undefined",false]}]
17:["$","section",null,{"className":"guideArticleSection","children":[["$","h2",null,{"children":"Frequently asked questions"}],[["$","div","Can I send a marketing broadcast from my personal Gmail inbox?",{"className":"guideFaq","children":[["$","h3",null,{"children":"Can I send a marketing broadcast from my personal Gmail inbox?"}],["$","p",null,{"children":"A normal mailbox is designed for conversations, not as a default bulk marketing service. Review the provider's sending policies and use suitable verified campaign infrastructure."}]]}],["$","div","Does DKIM or SPF guarantee my email will reach the inbox?",{"className":"guideFaq","children":[["$","h3",null,{"children":"Does DKIM or SPF guarantee my email will reach the inbox?"}],["$","p",null,{"children":"No. Authentication helps verify the sender, while placement also depends on reputation, content, audience engagement and receiving-provider decisions."}]]}],["$","div","Is UnifyDesk email campaign sending publicly available?",{"className":"guideFaq","children":[["$","h3",null,{"children":"Is UnifyDesk email campaign sending publicly available?"}],["$","p",null,{"children":"The managed email workflow is still in development. Public availability and final usage rates will be published ahead of broader access."}]]}]]]}]
