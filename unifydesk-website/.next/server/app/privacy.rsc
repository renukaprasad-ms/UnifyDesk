lassName":"legalIntro","children":"Proposed notice for India Early Access covering the UnifyDesk website, application and customer-authorized integrations. All disclosures require final operational and legal approval."}],["$","aside",null,{"children":"This is a working draft, not a final legal notice or binding agreement. Verified legal identity, public contact details and remaining backend checks are required before publication."}],["$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11"],"$L12"]}],"$L13"],null,"$L14"]}],{},null,false]},null,false]},null,false],"$L15",false]],"m":"$undefined","G":["$16",[]],"s":false,"S":true}
