9:["$","section","Provider identity and requests",{"children":[["$","h2",null,{"children":"Provider identity and requests"}],[["$","p","0",{"children":"UnifyDesk is being established as an Indian sole proprietorship. Before publication, insert the exact legal proprietor identity and verifiable legal correspondence address from approved business records."}],["$","p","1",{"children":"Privacy and grievance requests: support@unifydesk.in (business-supplied address; inbox receipt and handling must be verified before publication). Verified postal address: [CONFIRM BUSINESS NOTICE ADDRESS]. The legal address remains an unresolved release blocker."}]],"$undefined"]}]
a:["$","section","Information handled",{"children":[["$","h2",null,{"children":"Information handled"}],[["$","p","0",{"children":"We may process names, work email addresses, login and session records, workspace membership, role assignments, subscription details, technical diagnostics and support requests."}],["$","p","1",{"children":"Customer-controlled data can include imported contacts and phone numbers, opt-in/opt-out records, message headers (including To/CC/BCC), subjects and bodies, attachments, campaign audience and delivery status, WhatsApp metadata and advertising account data."}]],"$undefined"]}]
b:["$","section","Our role and customer responsibility",{"children":[["$","h2",null,{"children":"Our role and customer responsibility"}],[["$","p","0",{"children":"We operate account, security, website, service and billing workflows for UnifyDesk. Business customers choose whose contact, message and campaign data to submit and which providers to connect; those customers remain responsible for appropriate permissions, required notices and lawful outreach."}],["$","p","1",{"children":"Different processing activities may have different legal roles. The roles and instructions for business-customer content must be finalized in the Terms and a customer Data Processing Addendum."}]],"$undefined"]}]
c:["$","section","Google, Microsoft, Zoho and Meta integrations",{"children":[["$","h2",null,{"children":"Google, Microsoft, Zoho and Meta integrations"}],[["$","p","0",{"children":"The reviewed backend supports Gmail, Microsoft and Zoho inbox connections and Meta/WhatsApp and advertising integrations. Where authorized, it can synchronize email bodies, recipients, message metadata and attachment references, send messages and maintain provider connection state. Some attachments are streamed from the provider; other objects may use configured media storage."}],["$","p","1",{"children":"Default code scopes include Gmail gmail.modify; Microsoft Mail.ReadWrite and Mail.Send; and ZohoMail.messages.ALL. Production scopes and all data transfers need verification."}],["$","p","2",{"children":"Google API information must be handled under the Google API Services User Data Policy and applicable Limited Use requirements. UnifyDesk must audit these purposes and flows before submitting Google app verification."}]],"$undefined"]}]
d:["$","section","Why information is used",{"children":[["$","h2",null,{"children":"Why information is used"}],[["$","p","0",{"children":"We use information to authenticate users, enable requested workplace features, deliver communications through selected providers, manage contacts and consent, process legitimate billing, operate support, monitor security and investigate misuse."}],["$","p","1",{"children":"Storing a contact does not itself establish consent to receive marketing. The backend includes channel-specific preference and suppression logic."}]],"$undefined"]}]
e:["$","section","Disclosure to vendors",{"children":[["$","h2",null,{"children":"Disclosure to vendors"}],[["$","p","0",{"children":"Depending on which services are enabled, information may be shared with customer-authorized Google, Microsoft, Zoho and Meta integrations; messaging providers; configured hosting/object storage; payment processing; and website analytics."}],["$","p","1",{"children":"The exact legal vendor entities, environments, data locations and international transfers are not confirmed; review the Subprocessors inventory before publishing."}]],"$undefined"]}]
f:["$","section","Analytics and cookies",{"children":[["$","h2",null,{"children":"Analytics and cookies"}],[["$","p","0",{"children":"The marketing site's reviewed Next.js layout loads Google Analytics 4 after page interaction begins. No consent gate is visible in that file. Actual tracking, cookies, geographic access and applicable choice mechanisms must be checked before launch."}]],"$undefined"]}]
10:["$","section","Security and retention",{"children":[["$","h2",null,{"children":"Security and retention"}],[["$","p","0",{"children":"The reviewed code has role/company permission models, stored encrypted provider credential payloads, authorized attachment access, and deletion-processing services. This is not a certification that each control is deployed or independently audited."}],["$","p","1",{"children":"Account and workspace deletion are staged; the code includes a configurable default 30-day delayed purge, but this is not a universal retention promise. Notification records, imports, media, backups, security logs and financial records may have other timelines or exceptions. Some deleted contacts retain protected suppression fingerprints."}]],"$undefined"]}]
11:["$","section","Rights, complaints and changes",{"children":[["$","h2",null,{"children":"Rights, complaints and changes"}],[["$","p","0",{"children":"Requests should be authenticated and may need to be directed to the business customer controlling the recipient information. Publish an actual working email or public request form before approval; do not require a public data subject to create an account solely to ask for deletion."}],["$","p","1",{"children":"A final notice must explain rights and grievance procedures under applicable Indian law according to its current phased commencement schedule. Requests may be sent to support@unifydesk.in, subject to mailbox and workflow verification. The final notice needs a real effective date."}]],"$undefined"]}]
12:["$","section",null,{"children":[["$","h2",null,{"children":"Related documents"}],["$","ul",null,{"children":[["$","li","/data-deletion",{"children":["$","$L7",null,{"href":"/data-deletion","children":"Data Deletion"}]}],["$","li","/cookies",{"children":["$","$L7",null,{"href":"/cookies","children":"Cookies"}]}],["$","li","/subprocessors",{"children":["$","$L7",null,{"href":"/subprocessors","children":"Subprocessors"}]}],["$","li","/terms",{"children":["$","$L7",null,{"href":"/terms","children":"Terms"}]}]]}]]}]
