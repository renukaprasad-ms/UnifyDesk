# =============================================================================
# Email Platform - dedicated runtime configuration
# Copy to .env. Never commit the real .env file.
# =============================================================================

# Runtime
# Service-to-service authentication; 32+ unpredictable bytes; never exposed to clients.
EMAIL_PROVIDER_INTERNAL_API_TOKEN=
EMAIL_PROVIDER_PORT=8010
SNOWFLAKE_NODE_ID=100
JAVA_TOOL_OPTIONS=-Xms96m -Xmx320m -XX:MaxMetaspaceSize=128m -Xss512k -XX:ActiveProcessorCount=2

# Dedicated PostgreSQL
EMAIL_PROVIDER_DB_NAME=email_provider
SPRING_DATASOURCE_URL=jdbc:postgresql://email-postgres.email-platform.svc.cluster.local:5432/email_provider
SPRING_DATASOURCE_USERNAME=email_provider
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=0

# Dedicated Redis
EMAIL_PROVIDER_REDIS_HOST=email-redis.email-platform.svc.cluster.local
EMAIL_PROVIDER_REDIS_PORT=6379
EMAIL_PROVIDER_REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
EMAIL_PROVIDER_REDIS_MAXMEMORY=96mb

# Credential encryption / DKIM
# Generate with: openssl rand -base64 32
EMAIL_PROVIDER_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
EMAIL_PROVIDER_DKIM_SELECTOR=rly1

# Kafka
# local = this K3s cluster (default for the isolated test stack)
# external = existing broker(s)
EMAIL_PROVIDER_KAFKA_MODE=local
EMAIL_PROVIDER_KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=email-kafka.email-platform.svc.cluster.local:9092
KAFKA_CLIENT_ID=email-provider
KAFKA_CONSUMER_GROUP_ID=email-provider-delivery
EMAIL_PROVIDER_KAFKA_PARTITIONS=6
EMAIL_PROVIDER_KAFKA_REPLICATION_FACTOR=1
EMAIL_PROVIDER_LOCAL_KAFKA_HEAP_OPTS=-Xms128m -Xmx256m

EMAIL_PROVIDER_DELIVERY_TOPIC=email.delivery.requested
EMAIL_PROVIDER_LIFECYCLE_TOPIC=email.lifecycle.events
EMAIL_PROVIDER_VALIDATION_BATCH_TOPIC=email.validation.batch
EMAIL_PROVIDER_VALIDATION_LIFECYCLE_TOPIC=email.validation.lifecycle

# Transactional outbox
EMAIL_PROVIDER_OUTBOX_BATCH_SIZE=50
EMAIL_PROVIDER_OUTBOX_POLL_INTERVAL_MS=250
EMAIL_PROVIDER_OUTBOX_STALE_AFTER_SECONDS=120
EMAIL_PROVIDER_OUTBOX_MAX_ATTEMPTS=20

# Product API admission budget (global / project), UTC daily; initial controlled caps.
EMAIL_PROVIDER_PRODUCT_PROJECT_DAILY_QUOTA=1000
EMAIL_PROVIDER_PRODUCT_PLATFORM_DAILY_QUOTA=10000

# Delivery worker
# Initial conservative SMTP handoff caps; applied atomically in Redis.
EMAIL_PROVIDER_RATE_PLATFORM_PER_SECOND=10
EMAIL_PROVIDER_RATE_COMPANY_PER_SECOND=2
EMAIL_PROVIDER_RATE_DOMAIN_PER_SECOND=2
EMAIL_PROVIDER_DELIVERY_ENABLED=false
EMAIL_PROVIDER_MAX_RECIPIENTS=100
EMAIL_PROVIDER_MAX_BODY_BYTES=5242880
EMAIL_PROVIDER_PROCESSING_STALE_AFTER_SECONDS=300
EMAIL_PROVIDER_RETRY_POLL_INTERVAL_MS=1000
EMAIL_PROVIDER_DELIVERY_MAX_ATTEMPTS=8
EMAIL_PROVIDER_RETRY_INITIAL_SECONDS=60
EMAIL_PROVIDER_RETRY_MAX_SECONDS=3600

# Host Postfix
EMAIL_PROVIDER_SMTP_HOST=127.0.0.1
EMAIL_PROVIDER_SMTP_PORT=25
EMAIL_PROVIDER_SMTP_CONNECT_TIMEOUT_MS=5000
EMAIL_PROVIDER_SMTP_READ_TIMEOUT_MS=10000
EMAIL_PROVIDER_SMTP_EHLO_HOST=CHANGE_ME_MAIL_HOSTNAME
EMAIL_PROVIDER_ENVELOPE_FROM_DOMAIN=CHANGE_ME_ENVELOPE_FROM_DOMAIN

# Feedback
# Generate with: openssl rand -hex 32
EMAIL_PROVIDER_FEEDBACK_ENABLED=true
EMAIL_PROVIDER_FEEDBACK_TOKEN=CHANGE_ME_LONG_RANDOM_FEEDBACK_TOKEN

# Validation
EMAIL_PROVIDER_VALIDATION_ENABLED=true
EMAIL_PROVIDER_VALIDATION_BATCH_SIZE=100
EMAIL_PROVIDER_VALIDATION_KAFKA_GROUP=email-validator
EMAIL_PROVIDER_VALIDATION_EMAIL_CACHE_TTL_SECONDS=86400
EMAIL_PROVIDER_VALIDATION_DOMAIN_CACHE_TTL_SECONDS=21600
EMAIL_PROVIDER_VALIDATION_RETRY_POLL_INTERVAL_MS=5000
EMAIL_PROVIDER_VALIDATION_MAX_ATTEMPTS=4

# Keep SMTP validation disabled until a dedicated validator IP exists.
EMAIL_PROVIDER_VALIDATION_SMTP_ENABLED=false
EMAIL_PROVIDER_VALIDATION_CATCH_ALL_ENABLED=true
EMAIL_PROVIDER_VALIDATION_EHLO_HOST=CHANGE_ME_VALIDATOR_HOSTNAME
EMAIL_PROVIDER_VALIDATION_MAIL_FROM=
EMAIL_PROVIDER_VALIDATION_SMTP_CONNECT_TIMEOUT_MS=4000
EMAIL_PROVIDER_VALIDATION_SMTP_READ_TIMEOUT_MS=6000
EMAIL_PROVIDER_VALIDATION_PROBES_PER_DOMAIN_PER_MINUTE=20
EMAIL_PROVIDER_VALIDATION_PER_DOMAIN_CONCURRENCY=2
EMAIL_PROVIDER_VALIDATION_CONCURRENCY_LEASE_SECONDS=20

# Outgoing signed product webhooks: disabled by default, explicit exact HTTPS host allowlist.
EMAIL_PROVIDER_PRODUCT_WEBHOOKS_ENABLED=false
EMAIL_PROVIDER_WEBHOOK_ALLOWED_HOSTS=
EMAIL_PROVIDER_WEBHOOK_INTERVAL_MS=10000

# Required for marketing email. Generate long-lived random secret, keep private.
EMAIL_PROVIDER_UNSUBSCRIBE_SIGNING_KEY=
EMAIL_PROVIDER_PUBLIC_BASE_URL=https://api.email.unifydesk.in

# Standalone mail receiving: OFF until persistent PVC, private route, trusted
# MTA integration, virus/spam scanning and operator QA are complete.
# Never point the spool to /tmp, emptyDir, or container ephemeral storage.
EMAIL_MAIL_INBOUND_ENABLED=false
EMAIL_MAIL_INBOUND_SPOOL_PATH=
EMAIL_MAIL_INBOUND_MAX_BYTES=10485760
