EMAIL_PROVIDER_PORT=8010

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5003/email_provider
SPRING_DATASOURCE_USERNAME=email_provider
SPRING_DATASOURCE_PASSWORD=email_provider
SPRING_FLYWAY_ENABLED=true

SNOWFLAKE_NODE_ID=100

# Base64-encoded 32-byte AES key. Generate with: openssl rand -base64 32
EMAIL_PROVIDER_MASTER_KEY=
EMAIL_PROVIDER_DKIM_SELECTOR=rly1

EMAIL_PROVIDER_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9001
EMAIL_PROVIDER_DELIVERY_TOPIC=email.delivery.requested
EMAIL_PROVIDER_LIFECYCLE_TOPIC=email.lifecycle.events

EMAIL_PROVIDER_DELIVERY_ENABLED=false
EMAIL_PROVIDER_SMTP_HOST=127.0.0.1
EMAIL_PROVIDER_SMTP_PORT=25
EMAIL_PROVIDER_SMTP_EHLO_HOST=localhost
EMAIL_PROVIDER_ENVELOPE_FROM_DOMAIN=

# Internal Postfix/DSN feedback endpoints. Keep private and use a long random token.
EMAIL_PROVIDER_FEEDBACK_ENABLED=false
EMAIL_PROVIDER_FEEDBACK_TOKEN=
