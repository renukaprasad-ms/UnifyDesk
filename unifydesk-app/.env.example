# ==============================================================================
# Razorpay Billing & Payments (In-Page Popup SDK & Subscriptions)
# ==============================================================================
# Obtain Key ID and Secret from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks
# Set Webhook URL to: https://<domain>/api/v1/webhooks/razorpay
# Subscribed events: order.paid, payment.authorized, payment.captured, payment.failed,
#                    subscription.authenticated, subscription.activated, subscription.charged
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Frontend in-page Checkout SDK public Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Backend Gateway switches and endpoints
APP_BILLING_RAZORPAY_ENABLED=true
APP_BILLING_RAZORPAY_BASE_URL=https://api.razorpay.com/v1
APP_BILLING_RAZORPAY_RETURN_URL=http://localhost:5100/billing
APP_BILLING_RAZORPAY_NOTIFY_URL=http://localhost:8001/api/v1/webhooks/razorpay

# Polling and automatic reconciliation timings (optional)
APP_BILLING_RAZORPAY_RECONCILIATION_INTERVAL_MS=300000
APP_BILLING_RAZORPAY_RECONCILIATION_INITIAL_DELAY_MS=60000
