# UnifyDesk Managed SMS control plane.
# APP_MANAGED_SMS_MASTER_AUTH_KEY is platform-owned and must never be returned to customers.
# The control plane fails closed to manual review until the production MSG91 provisioning
# contract for PE/Header/template mappings has been validated with a real account.
APP_MANAGED_SMS_ENABLED=false
APP_MANAGED_SMS_PROVIDER=MSG91_SMS
APP_MANAGED_SMS_PROVIDER_MODE=CHILD_PER_COMPANY
APP_MANAGED_SMS_MASTER_AUTH_KEY=
# Shared-master sending is disabled by default and requires explicit architecture/provider approval.
APP_MANAGED_SMS_ALLOW_SHARED_MASTER=false
# High-entropy server keys used to derive per-provider-account webhook tokens. Never expose to customers.
APP_MANAGED_SMS_WEBHOOK_TOKEN_KEY=
APP_MANAGED_SMS_WEBHOOK_PREVIOUS_TOKEN_KEY=
# Optional UTC ISO-8601 expiry for the previous key during a bounded rotation overlap.
APP_MANAGED_SMS_WEBHOOK_PREVIOUS_TOKEN_VALID_UNTIL=
APP_MANAGED_SMS_COMPLIANCE_STALE_AFTER=7d
APP_MANAGED_SMS_PROVISIONING_POLL_INTERVAL=5s
APP_MANAGED_SMS_PROVISIONING_STALE_AFTER=5m
APP_MANAGED_SMS_COMPLIANCE_REFRESH_INTERVAL=5m
APP_MANAGED_SMS_PROVIDER_OBSERVATION_POLL_MS=60000
APP_MANAGED_SMS_PLATFORM_SENDING_ENABLED=false
APP_MANAGED_SMS_GLOBAL_MAX_PER_SECOND=20
APP_MANAGED_SMS_ACCOUNT_MAX_PER_SECOND=15
APP_MANAGED_SMS_COMPANY_MAX_PER_SECOND=10
APP_MANAGED_SMS_RUN_MAX_PER_SECOND=5
APP_MANAGED_SMS_CAMPAIGN_MAX_RECIPIENTS=5000
APP_MANAGED_SMS_NEW_TENANT_HOURLY_CAP=100
APP_MANAGED_SMS_NEW_TENANT_DAILY_CAP=500
APP_MANAGED_SMS_PROVIDER_BALANCE_RESERVE=100
APP_MANAGED_SMS_EVENT_REPLAY_WINDOW=10m

