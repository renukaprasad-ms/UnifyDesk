APP_MANAGED_EMAIL_PROVISIONING_STALE_AFTER=5m
APP_MANAGED_EMAIL_VERIFICATION_REFRESH_INTERVAL=5m
APP_MANAGED_EMAIL_ACCOUNT_RATE_SAFETY_CAP=1000
APP_MANAGED_EMAIL_NEW_TENANT_HOURLY_CAP=100
APP_MANAGED_EMAIL_NEW_TENANT_DAILY_CAP=500
APP_MANAGED_EMAIL_EVENT_REPLAY_WINDOW=10m

# Managed Email runtime safety controls
APP_MANAGED_EMAIL_COMPANY_MAX_PER_SECOND=25
APP_MANAGED_EMAIL_PLAN_MAX_PER_SECOND=25
APP_MANAGED_EMAIL_RUN_MAX_PER_SECOND=10
APP_MANAGED_EMAIL_NEW_TENANT_MAX_PER_SECOND=2
APP_MANAGED_EMAIL_ACCOUNT_DAILY_SAFETY_CAP=50000
APP_MANAGED_EMAIL_ESTABLISHED_HOURLY_CAP=5000
APP_MANAGED_EMAIL_ESTABLISHED_DAILY_CAP=25000
APP_MANAGED_EMAIL_CAMPAIGN_SIZE_CAP=5000
APP_MANAGED_EMAIL_SNS_REPLAY_WINDOW_SECONDS=600
APP_MANAGED_EMAIL_WEBHOOK_MAX_BYTES=262144
APP_MANAGED_EMAIL_WEBHOOK_MAX_JSON_DEPTH=32
APP_MANAGED_EMAIL_SIGNING_CERTIFICATE_MAX_BYTES=65536
APP_MANAGED_EMAIL_STALE_RESERVATION_MINUTES=30
APP_MANAGED_EMAIL_REPUTATION_WINDOW_HOURS=24
